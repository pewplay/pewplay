# ── Required ──────────────────────────────────
ORG_NAME=your-github-org
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Optional (defaults shown) ────────────────
# SITE_URL=https://www.pewplay.com
# SITE_NAME=PewPlay
# SITE_TAGLINE=Free Online Games
# SITE_DESC=Play the best free online games directly in your browser. No downloads, no installs — just play.
# SITE_LANG=en
# CLONE_CONCURRENCY=5

# ── Google AdSense / Analytics ───────────────
# Optional override; defaults to the PewPlay publisher ID below.
# ADSENSE_PUBLISHER_ID=pub-6003231730369215
# GA4 Measurement ID. Leave empty/commented to disable Analytics.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Privacy policy ────────────────────────────
# Contact shown in the generated Privacy & Cookie Policy.
PRIVACY_CONTACT_EMAIL=contact@pewplay.com
# Replace with the legal person/company operating the site if different from the brand name.
# PRIVACY_CONTROLLER_NAME=PewPlay
# Recommended if applicable to your legal setup/jurisdiction.
# PRIVACY_CONTROLLER_ADDRESS=Street, ZIP City, Country

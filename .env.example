# Copia in .env SOLO per build/deploy dal tuo computer.
# Su GitHub Actions questi valori sono "Secrets" del repo (vedi README).

# Token GitHub (facoltativo per repo pubblici, consigliato per non finire nel limite API;
# obbligatorio se hai giochi in repo privati). Permessi: Contents read-only sull'organizzazione.
GH_TOKEN=

# Solo per `npm run deploy` dal tuo computer
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
